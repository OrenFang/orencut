  "captions": [
    {"start":0,"end":20,"text":null},
    {"start":20,"end":80,"text":"美国政府刚把"},
    {"start":80,"end":160,"text":"DeepSeek 写进禁令"},
    {"start":160,"end":220,"text":"联邦机构的电脑里"},
    {"start":220,"end":320,"text":"DeepSeek 要全部卸掉"},
    {"start":320,"end":360,"text":"结果两天后"},
    {"start":360,"end":460,"text":"又传出它正在收尾一轮"},
    {"start":460,"end":560,"text":"1000亿人民币的融资"},
    {"start":560,"end":670,"text":"腾讯、宁德时代都在名单里"},
    {"start":670,"end":770,"text":"连中国芯片圈的资本也来了"},
    {"start":770,"end":777,"text":"连中国芯片圈的资本也来了"},
    {"start":777,"end":780,"text":"这周 X 上，整个 AI 圈都疯了"},
    {"start":780,"end":920,"text":"这周 X 上，整个 AI 圈都疯了"},
    {"start":920,"end":940,"text":null},
    {"start":940,"end":1040,"text":"可这家公司最奇怪的地方是"},
    {"start":1040,"end":1200,"text":"别人忙着卖的东西它让你直接拿走"},
    {"start":1200,"end":1270,"text":"同样是做大模型"},
    {"start":1270,"end":1340,"text":"OpenAI和 Claude"},
    {"start":1340,"end":1439,"text":"最强的模型锁起来收费"},
    {"start":1439,"end":1600,"text":"豆包、千问背后是大厂砸钱抢用户"},
    {"start":1600,"end":1720,"text":"DeepSeek 呢很少砸钱买用户"},
    {"start":1720,"end":1770,"text":"不急着赚钱"},
    {"start":1770,"end":1940,"text":"最好的模型直接免费送给全世界"},
    {"start":1940,"end":1990,"text":"它凭什么"},
    {"start":1990,"end":2100,"text":"今天这期我讲清楚三件事"},
    {"start":2100,"end":2180,"text":"第一 梁文锋是谁"},
    {"start":2180,"end":2290,"text":"DeepSeek 凭什么这么特立独行"},
    {"start":2290,"end":2430,"text":"第二 这1000亿到底是谁给的"},
    {"start":2430,"end":2450,"text":"第三"},
    {"start":2450,"end":2540,"text":"DeepSeek 接下来要干什么"},
    {"start":2540,"end":2690,"text":"美国到底封不封得住它"},
    {"start":2690,"end":2810,"text":"先说梁文锋"},
    {"start":2810,"end":2880,"text":"1985年出生在广东湛江"},
    {"start":2880,"end":2920,"text":"1985年出生在广东湛江"},
    {"start":2920,"end":3060,"text":"浙江大学本科读电子信息工程"},
    {"start":3060,"end":3180,"text":"硕士读信息与通信工程"},
    {"start":3180,"end":3190,"text":"硕士读信息与通信工程"},
    {"start":3190,"end":3210,"text":"硕士读信息与通信工程"},
    {"start":3210,"end":3320,"text":"2008年金融危机 他还在读研"},
    {"start":3320,"end":3480,"text":"就开始琢磨用机器学习做交易"},
    {"start":3480,"end":3600,"text":"2015年 他创办了幻方量化"},
    {"start":3600,"end":3630,"text":"说白了"},
    {"start":3630,"end":3790,"text":"就是让电脑自己做交易的私募基金"},
    {"start":3790,"end":3839,"text":"到2021年"},
    {"start":3839,"end":3980,"text":"幻方管理的规模一度超过1000亿"},
    {"start":3980,"end":4112,"text":"成了国内最头部的量化私募之一"},
    {"start":4112,"end":4120,"text":"量化最吃算力"},
    {"start":4120,"end":4190,"text":"量化最吃算力"},
    {"start":4190,"end":4360,"text":"所以幻方很早就自己建算力集群"},
    {"start":4360,"end":4470,"text":"2020年萤火一号投用"},
    {"start":4470,"end":4550,"text":"花了将近2个亿"},
    {"start":4550,"end":4630,"text":"2021年 大模型还没火"},
    {"start":4630,"end":4750,"text":"它又投了10个亿建萤火二号"},
    {"start":4750,"end":4830,"text":"据报道里面有大约"},
    {"start":4830,"end":4920,"text":"1万张英伟达 A100"},
    {"start":4920,"end":5010,"text":"那时候没几个人看得懂"},
    {"start":5010,"end":5070,"text":"一家炒股的公司"},
    {"start":5070,"end":5150,"text":"买这么多显卡干嘛"},
    {"start":5150,"end":5270,"text":"两年后答案来了"},
    {"start":5270,"end":5320,"text":"2023年4月"},
    {"start":5320,"end":5440,"text":"幻方宣布做通用人工智能"},
    {"start":5440,"end":5550,"text":"7月成立了 DeepSeek"},
    {"start":5550,"end":5640,"text":"2025年1月 R1 发布"},
    {"start":5640,"end":5770,"text":"冲上美区苹果商店免费榜第一"},
    {"start":5770,"end":5910,"text":"英伟达一天跌了将近17%"},
    {"start":5910,"end":6040,"text":"市值蒸发大约5900亿美元"},
    {"start":6040,"end":6100,"text":"所以说 DeepSeek"},
    {"start":6100,"end":6160,"text":"不是突然冒出来的"},
    {"start":6160,"end":6270,"text":"它背后是一个靠炒股赚钱"},
    {"start":6270,"end":6440,"text":"提前好几年攒好了钱和卡的人"},
    {"start":6440,"end":6450,"text":null},
    {"start":6450,"end":6540,"text":"那它到底特立独行在哪"},
    {"start":6540,"end":6630,"text":"我觉得有三个不一样"},
    {"start":6630,"end":6790,"text":"第一个也是最根本的是钱"},
    {"start":6790,"end":6880,"text":"你看其他做大模型的"},
    {"start":6880,"end":6950,"text":"公司钱都有来处"},
    {"start":6950,"end":7020,"text":"OpenAI 今年一轮"},
    {"start":7020,"end":7120,"text":"就拿了1000多亿美元的承诺资本"},
    {"start":7120,"end":7250,"text":"Anthropic 也刚融了650亿美元"},
    {"start":7250,"end":7370,"text":"投资人的钱迟早要回报"},
    {"start":7370,"end":7500,"text":"千问是阿里的豆包是字节的"},
    {"start":7500,"end":7640,"text":"模型要帮母公司卖云、带流量"},
    {"start":7640,"end":7740,"text":"Kimi、MiniMax 这些创业公司"},
    {"start":7740,"end":7820,"text":"一路靠融资走过来"},
    {"start":7820,"end":7920,"text":"MiniMax 今年已经在香港上市"},
    {"start":7920,"end":8040,"text":"要对投资人和股民交代增长"},
    {"start":8040,"end":8140,"text":"而 DeepSeek 成立后的头三年"},
    {"start":8140,"end":8220,"text":"没拿过1分钱外部融资"},
    {"start":8220,"end":8320,"text":"花的是幻方自己的钱"},
    {"start":8320,"end":8430,"text":"梁文锋早年接受采访时说过"},
    {"start":8430,"end":8520,"text":"很多风投有退出需求"},
    {"start":8520,"end":8580,"text":"希望尽快商业化"},
    {"start":8580,"end":8670,"text":"而他们要优先做研究"},
    {"start":8670,"end":8760,"text":"很难从风投那里拿钱"},
    {"start":8760,"end":8830,"text":"没有投资人催上市"},
    {"start":8830,"end":8900,"text":"没有母公司要业绩"},
    {"start":8900,"end":9030,"text":"所以它可以只干一件事"},
    {"start":9030,"end":9100,"text":"做最好的模型"},
    {"start":9100,"end":9210,"text":"第二个不一样是开源"},
    {"start":9210,"end":9320,"text":"OpenAI、Anthropic、Google"},
    {"start":9320,"end":9430,"text":"最强的模型都不给你下载"},
    {"start":9430,"end":9470,"text":"只能付钱用"},
    {"start":9470,"end":9580,"text":"国内的千问、Kimi、MiniMax"},
    {"start":9580,"end":9680,"text":"最新模型也开放了权重"},
    {"start":9680,"end":9780,"text":"但许可证里都加了条件"},
    {"start":9780,"end":9880,"text":"比如收入超过一定规模的公司"},
    {"start":9880,"end":9950,"text":"要另外签协议"},
    {"start":9950,"end":10030,"text":"DeepSeek 用的是 MIT"},
    {"start":10030,"end":10110,"text":"几乎没有附加条件"},
    {"start":10110,"end":10230,"text":"谁都能下载、修改、拿去商用"},
    {"start":10230,"end":10240,"text":null},
    {"start":10240,"end":10330,"text":"光是在 Hugging Face上"},
    {"start":10330,"end":10410,"text":"直接基于它改出来的模型"},
    {"start":10410,"end":10500,"text":"就有9300 多个"},
    {"start":10500,"end":10510,"text":null},
    {"start":10510,"end":10580,"text":"那它靠什么赚钱"},
    {"start":10580,"end":10720,"text":"很简单 模型免费给 服务收钱"},
    {"start":10720,"end":10790,"text":"你想自己跑 拿走"},
    {"start":10790,"end":10860,"text":"你懒得自己部署"},
    {"start":10860,"end":10930,"text":"用它的 API付钱"},
    {"start":10930,"end":10950,"text":null},
    {"start":10950,"end":11010,"text":"价格有多低"},
    {"start":11010,"end":11020,"text":null},
    {"start":11020,"end":11090,"text":"每百万 token 的输出"},
    {"start":11090,"end":11200,"text":"GPT-6 Astra 标价 50 美元"},
    {"start":11200,"end":11300,"text":"Claude Opus 20 美元"},
    {"start":11300,"end":11410,"text":"DeepSeek Pro 高峰时段也不到"},
    {"start":11410,"end":11430,"text":"4美元"},
    {"start":11430,"end":11450,"text":null},
    {"start":11450,"end":11550,"text":"据报道今年前7个月"},
    {"start":11550,"end":11680,"text":"它收入大约4.75亿人民币"},
    {"start":11680,"end":11740,"text":"整体还在亏"},
    {"start":11740,"end":11870,"text":"梁文锋说过两句话 我印象特别深"},
    {"start":11870,"end":11960,"text":"在颠覆性的技术面前"},
    {"start":11960,"end":12090,"text":"闭源形成的护城河是短暂的"},
    {"start":12090,"end":12190,"text":"开源更像一个文化行为"},
    {"start":12190,"end":12250,"text":"而非商业行为"},
    {"start":12250,"end":12350,"text":"他不靠藏着模型赚钱"},
    {"start":12350,"end":12450,"text":"所以也就不怕你拿走"},
    {"start":12450,"end":12590,"text":"第三个不一样是打法"},
    {"start":12590,"end":12730,"text":"今年春节 千问砸了30亿请客"},
    {"start":12730,"end":12810,"text":"豆包上春晚发红包"},
    {"start":12810,"end":12890,"text":"抢用户抢得很凶"},
    {"start":12890,"end":12960,"text":"DeepSeek 很少搞"},
    {"start":12960,"end":13020,"text":"这种大手笔的补贴"},
    {"start":13020,"end":13180,"text":"App 能火起来靠的是 R1 本身"},
    {"start":13180,"end":13200,"text":null},
    {"start":13200,"end":13250,"text":"第三方统计"},
    {"start":13250,"end":13300,"text":"今年6月"},
    {"start":13300,"end":13400,"text":"DeepSeek App 的全球月活"},
    {"start":13400,"end":13470,"text":"大约1.4亿"},
    {"start":13470,"end":13500,"text":null},
    {"start":13500,"end":13620,"text":"它把力气花在了另外两个地方"},
    {"start":13620,"end":13660,"text":"一是降成本"},
    {"start":13660,"end":13720,"text":"二是人才"},
    {"start":13720,"end":13750,"text":"二是人才"},
    {"start":13750,"end":13780,"text":"二是人才"},
    {"start":13780,"end":13800,"text":"2024年"},
    {"start":13800,"end":13920,"text":"它在模型架构上做了一系列改进"},
    {"start":13920,"end":14000,"text":"把API 价格打到"},
    {"start":14000,"end":14100,"text":"每百万 token 1块钱"},
    {"start":14100,"end":14240,"text":"差不多是 GPT-4 Turbo 的1/70"},
    {"start":14240,"end":14350,"text":"直接被叫成 AI界的拼多多"},
    {"start":14350,"end":14450,"text":"字节、阿里这些大厂"},
    {"start":14450,"end":14530,"text":"也纷纷跟着降价"},
    {"start":14530,"end":14620,"text":"招人也很有特点"},
    {"start":14620,"end":14730,"text":"梁文锋说做出这些模型的"},
    {"start":14730,"end":14840,"text":"并没有什么高深莫测的奇才"},
    {"start":14840,"end":14970,"text":"都是一些顶尖高校的应届毕业生"},
    {"start":14970,"end":15030,"text":"没毕业的博士生"},
    {"start":15030,"end":15130,"text":"还有毕业才几年的年轻人"},
    {"start":15130,"end":15230,"text":"他选人的标准一直"},
    {"start":15230,"end":15320,"text":"都是热爱和好奇心"},
    {"start":15320,"end":15330,"text":null},
    {"start":15330,"end":15360,"text":"可是今年"},
    {"start":15360,"end":15470,"text":"这个不拿外部融资的公司"},
    {"start":15470,"end":15580,"text":"突然开始大笔融资了"},
    {"start":15580,"end":15740,"text":"6月完成第一轮 大约510亿人民币"},
    {"start":15740,"end":15770,"text":"据报道"},
    {"start":15770,"end":15890,"text":"梁文锋自己就出了大约200亿"},
    {"start":15890,"end":16010,"text":"腾讯100亿 宁德时代50亿"},
    {"start":16010,"end":16100,"text":"国家人工智能产业"},
    {"start":16100,"end":16190,"text":"投资基金也在里面"},
    {"start":16190,"end":16310,"text":"10月又传出第二轮 大约1000亿"},
    {"start":16310,"end":16420,"text":"投前估值大约5000亿"},
    {"start":16420,"end":16520,"text":"这一轮的名单就更有意思了"},
    {"start":16520,"end":16600,"text":"我们按行业拆开看"},
    {"start":16600,"end":16660,"text":"第一类是芯片"},
    {"start":16660,"end":16770,"text":"兆易创新背后的石溪资本"},
    {"start":16770,"end":16880,"text":"中芯国际旗下的中芯聚源"},
    {"start":16880,"end":16950,"text":"一个做存储芯片"},
    {"start":16950,"end":17030,"text":"一个做芯片制造"},
    {"start":17030,"end":17150,"text":"第二类是真正要用 AI 的产业"},
    {"start":17150,"end":17220,"text":"宁德时代做电池"},
    {"start":17220,"end":17330,"text":"吉利造车 美的做家电"},
    {"start":17330,"end":17390,"text":"美团做外卖"},
    {"start":17390,"end":17460,"text":"第三类才是腾讯"},
    {"start":17460,"end":17550,"text":"网易这样的互联网公司"},
    {"start":17550,"end":17680,"text":"和 IDG、君联这些投资机构"},
    {"start":17680,"end":17720,"text":"你会发现"},
    {"start":17720,"end":17860,"text":"这不太像一群财务投资人在追风口"},
    {"start":17860,"end":17960,"text":"更像是半条中国产业链"},
    {"start":17960,"end":18040,"text":"一起押注了 DeepSeek"},
    {"start":18040,"end":18050,"text":null},
    {"start":18050,"end":18100,"text":"而且钱进来了"},
    {"start":18100,"end":18200,"text":"方向盘还在梁文锋手里"},
    {"start":18200,"end":18220,"text":"据报道"},
    {"start":18220,"end":18330,"text":"第一轮里除了国家 AI 基金"},
    {"start":18330,"end":18430,"text":"其他投资人的钱都放进了"},
    {"start":18430,"end":18510,"text":"梁文锋管理的合伙企业"},
    {"start":18510,"end":18600,"text":"不享有投票权"},
    {"start":18600,"end":18610,"text":"那拿着这1000亿"},
    {"start":18610,"end":18680,"text":"那拿着这1000亿"},
    {"start":18680,"end":18780,"text":"DeepSeek 接下来要去哪"},
    {"start":18780,"end":18860,"text":"确定的有两件事"},
    {"start":18860,"end":19010,"text":"一是继续堆算力 据彭博报道"},
    {"start":19010,"end":19120,"text":"它计划部署至少16万颗"},
    {"start":19120,"end":19199,"text":"华为昇腾950芯片"},
    {"start":19199,"end":19290,"text":"还在内蒙古乌兰察布"},
    {"start":19290,"end":19360,"text":"建大型数据中心"},
    {"start":19360,"end":19480,"text":"二是准备上市 据路透报道"},
    {"start":19480,"end":19620,"text":"它已经请中信证券筹备科创板上市"},
    {"start":19620,"end":19710,"text":"下面是我自己的猜测"},
    {"start":19710,"end":19860,"text":"第一 它会把国产算力这条路走通"},
    {"start":19860,"end":19950,"text":"美国卡它的高端芯片"},
    {"start":19950,"end":20030,"text":"那就用昇腾跑模型"},
    {"start":20030,"end":20200,"text":"再用中芯和兆易补上制造和存储"},
    {"start":20200,"end":20250,"text":"10月它开源的"},
    {"start":20250,"end":20320,"text":"推理框架 DeepInfer"},
    {"start":20320,"end":20410,"text":"已经能跑在昇腾上了"},
    {"start":20410,"end":20550,"text":"第二 模型会走进具体的产业"},
    {"start":20550,"end":20670,"text":"宁德的电池研发、吉利的车"},
    {"start":20670,"end":20770,"text":"美的的家电、美团的外卖"},
    {"start":20770,"end":20810,"text":"都可能成为"},
    {"start":20810,"end":20890,"text":"DeepSeek 的落地场景"},
    {"start":20890,"end":21010,"text":"第三 开源大概率还会继续"},
    {"start":21010,"end":21090,"text":"因为开源让它的模型"},
    {"start":21090,"end":21180,"text":"变成全世界都在用的底座"},
    {"start":21180,"end":21200,"text":null},
    {"start":21200,"end":21310,"text":"在模型聚合平台 OpenRouter 上"},
    {"start":21310,"end":21360,"text":"最近7天"},
    {"start":21360,"end":21440,"text":"DeepSeek 的 token 用量"},
    {"start":21440,"end":21510,"text":"占了31% 排第一"},
    {"start":21510,"end":21530,"text":null},
    {"start":21530,"end":21670,"text":"这本身就是它最大的筹码"},
    {"start":21670,"end":21760,"text":"最后回到开头的问题"},
    {"start":21760,"end":21870,"text":"美国能封掉 DeepSeek 吗"},
    {"start":21870,"end":21970,"text":"先看禁令到底禁了什么"},
    {"start":21970,"end":22100,"text":"它是美国国土安全部7月签的"},
    {"start":22100,"end":22150,"text":"10月才公开"},
    {"start":22150,"end":22230,"text":"管的是联邦民用机构"},
    {"start":22230,"end":22340,"text":"不许再采购 DeepSeek 的产品"},
    {"start":22340,"end":22430,"text":"已经装了的要移除"},
    {"start":22430,"end":22570,"text":"给政府干活的承包商也受影响"},
    {"start":22570,"end":22640,"text":"但普通美国人"},
    {"start":22640,"end":22750,"text":"普通美国公司不在里面"},
    {"start":22750,"end":22820,"text":"禁令7月签了以后"},
    {"start":22820,"end":22960,"text":"DeepSeek 7月、8月、9月、10月"},
    {"start":22960,"end":23060,"text":"每个月都有新模型开源"},
    {"start":23060,"end":23140,"text":"禁令公开没两天"},
    {"start":23140,"end":23220,"text":"美国的 AI平台 Fireworks"},
    {"start":23220,"end":23280,"text":"还在X上大推"},
    {"start":23280,"end":23360,"text":"DeepSeek 的新模型"},
    {"start":23360,"end":23480,"text":"它的模型早就是一份公开的文件"},
    {"start":23480,"end":23570,"text":"被复制到了全世界"},
    {"start":23570,"end":23680,"text":"所以 你封你的 我开源我的"},
    {"start":23680,"end":23750,"text":"封得住一家公司"},
    {"start":23750,"end":23840,"text":"封不住一份已经公开的文件"},
    {"start":23840,"end":23930,"text":null},
    {"start":23930,"end":23990,"text":"AI这场竞争"},
    {"start":23990,"end":24000,"text":null},
    {"start":24000,"end":24140,"text":"最后比的可能不是谁把门关得更紧"},
    {"start":24140,"end":24150,"text":null},
    {"start":24150,"end":24290,"text":"而是谁让更多人用上了自己的东西"},
    {"start":24290,"end":24300,"text":null},
    {"start":24300,"end":24400,"text":"DeepSeek 选了后一条路"},
    {"start":24400,"end":24410,"text":null},
    {"start":24410,"end":24460,"text":"能走多远"},
    {"start":24460,"end":24470,"text":"我们接着看"},
    {"start":24470,"end":24480,"text":"我们接着看"},
    {"start":24480,"end":24503,"text":"我们接着看"},
    {"start":24503,"end":24832,"text":null}
  ],
