  "captions":[
    {"start":0,"end":12,"text":null},
    {"start":12,"end":98,"text":"一分钟看完本周 AI 大事"},
    {"start":98,"end":99,"text":null},
    {"start":99,"end":162,"text":"谷歌 DeepMind 开放实时世界模型"},
    {"start":162,"end":188,"text":"Genie 4"},
    {"start":188,"end":247,"text":"一句话就能生成 720p"},
    {"start":247,"end":305,"text":"24 帧带立体声的互动世界"},
    {"start":305,"end":336,"text":"键盘随便走动"},
    {"start":336,"end":404,"text":"走到一半还能打字临时加暴风雪"},
    {"start":404,"end":469,"text":"现已上线 Gemini API"},
    {"start":469,"end":470,"text":null},
    {"start":470,"end":538,"text":"本期视频由 Fred 全自动剪辑输出"},
    {"start":538,"end":612,"text":"有兴趣评论区扣 Fred"},
    {"start":612,"end":675,"text":"机器人这周全面进厂了"},
    {"start":675,"end":729,"text":"英伟达开源 GR00T 2 模型"},
    {"start":729,"end":826,"text":"1 倍速无剪辑实拍控制真实灵巧手连续作业"},
    {"start":826,"end":885,"text":"谷歌发布 Gemini Robotics 2.5"},
    {"start":885,"end":983,"text":"在奔驰产线配合人形机器人成功率冲到 96%"},
    {"start":983,"end":1064,"text":"对话一小时就能搭出分拣机械臂"},
    {"start":1064,"end":1065,"text":null},
    {"start":1065,"end":1091,"text":"谷歌还连发"},
    {"start":1091,"end":1145,"text":"Gemini 4 Hydrogen 和 Neon"},
    {"start":1145,"end":1209,"text":"Mac 版 Gemini 上线电脑操控"},
    {"start":1209,"end":1274,"text":"能在后台跨应用帮你干活"},
    {"start":1274,"end":1340,"text":"Gemini Tasks 也免费开放六国"},
    {"start":1340,"end":1417,"text":"直接替你打电话给商家预约"},
    {"start":1417,"end":1418,"text":null},
    {"start":1418,"end":1473,"text":"OpenAI 发布 GPT-6.2"},
    {"start":1473,"end":1541,"text":"单任务成本砍到上一代三分之一"},
    {"start":1541,"end":1624,"text":"紧接着 ChatGPT 上线 Space 协作空间"},
    {"start":1624,"end":1743,"text":"把文档、幻灯片、图片和交互图表全收进一个工作区"},
    {"start":1743,"end":1792,"text":"还能多人一起改"},
    {"start":1792,"end":1853,"text":"可灵发布 Kling Image 4.0"},
    {"start":1853,"end":1905,"text":"首次支持原生 8K 直出"},
    {"start":1905,"end":1958,"text":"单图能稳塞 2000 字排版"},
    {"start":1958,"end":2026,"text":"还能一次生成十张风格一致的组图"},
    {"start":2026,"end":2124,"text":"在第三方评测里图像编辑挤进全球第六"},
    {"start":2124,"end":2195,"text":"做 AI 音乐的 Suno 也开始做视频了"},
    {"start":2195,"end":2270,"text":"新功能 Visuals 能按歌单生成最长"},
    {"start":2270,"end":2310,"text":"15 秒卡点短片"},
    {"start":2310,"end":2367,"text":"自动跟着鼓点和歌词对口型"},
    {"start":2367,"end":2423,"text":"还能继续编辑延长"},
    {"start":2423,"end":2477,"text":"国产模型也在狂卷"},
    {"start":2477,"end":2523,"text":"阿里发布 Qwen4-Max"},
    {"start":2523,"end":2568,"text":"2.4 万亿骨干参数"},
    {"start":2568,"end":2631,"text":"登顶 Agent Arena 中国第一"},
    {"start":2631,"end":2682,"text":"腾讯则把混元彻底开源"},
    {"start":2682,"end":2740,"text":"先放 2240 亿轻量版"},
    {"start":2740,"end":2849,"text":"接着全量开源 7700 亿旗舰 Hy4 权重"},
    {"start":2849,"end":2930,"text":"谷歌 NotebookLM 上线一键建站"},
    {"start":2930,"end":3018,"text":"把资料丢进去聊天框输入一句做个网站"},
    {"start":3018,"end":3116,"text":"直接给你生成可交互的仪表盘和可视化网页"},
    {"start":3116,"end":3169,"text":"全球免费开放"},
    {"start":3169,"end":3170,"text":null},
    {"start":3170,"end":3230,"text":"最后一条数学界炸了"},
    {"start":3230,"end":3271,"text":"Anthropic 数学家宣布和"},
    {"start":3271,"end":3307,"text":"Claude 合作六周"},
    {"start":3307,"end":3389,"text":"挑战 167 年未解的黎曼猜想"},
    {"start":3389,"end":3419,"text":"没有传统论文"},
    {"start":3419,"end":3505,"text":"直接甩出 17.5 万个 Lean 文件"},
    {"start":3505,"end":3567,"text":"1737 万行验证代码"},
    {"start":3567,"end":3643,"text":"目前 MIT 数学家已跑通初步编译"},
    {"start":3643,"end":3706,"text":"人工复核还在进行中"},
    {"start":3706,"end":3765,"text":"以上就是本周的 AI 大事"},
    {"start":3765,"end":3789,"text":null}
